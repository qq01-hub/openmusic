# 基于宝塔站点配置优化：静态 Nginx 直出，动态回源 Node
# 前端：/www/openmusic/client/dist
# 后端：/www/openmusic/server → 127.0.0.1:4000（建议 .env 设置 HOST=127.0.0.1）
# 请按实际域名与部署路径替换 music.example.com、/www/openmusic
# 保存后执行：nginx -t && nginx -s reload
#
# 若前置接入 EdgeOne / Cloudflare 等 CDN，建议限制源站仅接受 CDN 回源或在回源规则注入自定义密钥头，
# 再通过 map 仅在密钥匹配时透传 EO-Connecting-IP / CF-Connecting-IP，防止公网直连伪造真实 IP
# 精简通用版见 deploy/nginx.conf.example

upstream openmusic_backend {
    server 127.0.0.1:4000;
    keepalive 32;
    # 略小于 OpenMusic Node 的 keepAliveTimeout（65s），避免空闲长连接竞态断开
    keepalive_timeout 60s;
}

map $http_upgrade $openmusic_connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen 443 ssl;
    # 仅在源站直连且防火墙放行 UDP 443 时按需开启 QUIC / HTTP3
    # listen 443 quic;
    http2 on;
    listen [::]:80;
    server_name music.example.com;

    # 前端构建目录
    root /www/openmusic/client/dist;
    index index.html;
    server_tokens off;
    client_max_body_size 20m;

    include /www/server/panel/vhost/nginx/extension/music.example.com/*.conf;

    #CERT-APPLY-CHECK--START
    # 用于SSL证书申请时的文件验证相关配置 -- 请勿删除
    include /www/server/panel/vhost/nginx/well-known/music.example.com.conf;
    #CERT-APPLY-CHECK--END

    #SSL-START SSL相关配置，请勿删除或修改下一行带注释的404规则
    #error_page 404/404.html;

    #HTTP_TO_HTTPS_START
    set $isRedcert 1;
    if ($server_port != 443) {
        set $isRedcert 2;
    }
    if ( $uri ~ /\.well-known/ ) {
        set $isRedcert 1;
    }
    if ($isRedcert != 1) {
        rewrite ^(/.*)$ https://$host$1 permanent;
    }
    #HTTP_TO_HTTPS_END

    ssl_certificate /www/server/panel/vhost/cert/music.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/music.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 避免 Nginx 与 Node 重复输出相同安全响应头
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    error_page 497 https://$host$request_uri;
    #SSL-END
	#引用重定向规则，注释后配置的重定向代理将无效
	include /www/server/panel/vhost/nginx/redirect/music.example.com/*.conf;
	

    #REDIRECT START
    #REDIRECT END

    #ERROR-PAGE-START
    #error_page 404 /404.html;
    #error_page 502 /502.html;
    #ERROR-PAGE-END

    #PHP-INFO-START  Node 站不需要 PHP，注释掉避免干扰
    # include enable-php-00.conf;
    #PHP-INFO-END

    #IP-RESTRICT-START
    #IP-RESTRICT-END

    #BASICAUTH START
    #BASICAUTH END

    #SUB_FILTER START
    #SUB_FILTER END

    #GZIP START
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 4;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        application/javascript
        application/x-javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml
        font/ttf
        font/otf
        application/font-woff
        application/font-woff2;
    #GZIP END

    #GLOBAL-CACHE START
    #GLOBAL-CACHE END

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    #WEBSOCKET-SUPPORT START
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $openmusic_connection_upgrade;
    #WEBSOCKET-SUPPORT END

    #PROXY-CONF-START

    location /socket.io/ {
        proxy_pass http://openmusic_backend/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $openmusic_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_buffering off;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # 必须写在 /api 前面
    location ^~ /api/media-proxy {
        proxy_cache off;
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_force_ranges on;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /api/ {
        proxy_cache off;
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location ^~ /downloads/ {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /wx-proxy {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    location ^~ /cgi-bin/ {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    location = /robots.txt {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    location = /sitemap.xml {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # 首页 HTML 走 Node，保证百度验证 meta 写入源码
    location = / {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    location = /index.html {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # 动态会话页由 Node 返回 X-Robots-Tag: noindex，避免被收录
    location ^~ /room/ {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    location ^~ /tv/ {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # /admin 与自定义后台入口由 Node 校验；随机后台路径经下方 @openmusic_not_found 进入 Node 并返回 200
    location = /admin {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # 静态直出（仅用 add_header Cache-Control 避免重复头，并补齐安全头）
    location = /version.json {
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    location ^~ /qface/ {
    alias /www/openmusic/static/qface/;
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    location ^~ /desk-pet/ {
    alias /www/openmusic/static/desk-pet/;
        add_header Cache-Control "public, max-age=2592000";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    # Sonic Workshop 的 sandbox iframe 使用 opaque origin；仅为公开静态资源允许 Origin: null，不允许凭据
    location ^~ /vendor/sonic-workshop/ {
    alias /www/openmusic/static/vendor/sonic-workshop/;
        add_header Cache-Control "public, max-age=2592000";
        add_header Access-Control-Allow-Origin "null" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    location ^~ /vendor/folia/assets/ {
    alias /www/openmusic/static/vendor/folia/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    location ^~ /vendor/folia/ {
    alias /www/openmusic/static/vendor/folia/;
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    location ^~ /vendor/ {
    alias /www/openmusic/static/vendor/;
        add_header Cache-Control "public, max-age=2592000";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.svg {
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    location = /favicon.ico {
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    location = /apple-touch-icon.png {
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    location = /site.webmanifest {
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
        default_type application/manifest+json;
    }

    location = /og-cover.webp {
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    location = /og-cover.png {
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    # 未知路径保持 404 状态，同时交给前端展示 404 页面
    location / {
        error_page 404 = @openmusic_not_found;
        try_files $uri $uri/ =404;
    }

    location @openmusic_not_found {
        proxy_pass http://openmusic_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header EO-Connecting-IP $http_eo_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header iqp $http_iqp;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    #PROXY-CONF-END

    #SERVER-BLOCK START
    #SERVER-BLOCK END

    # 禁止访问的敏感文件
    location ~* (\.user.ini|\.htaccess|\.htpasswd|\.env.*|\.project|\.bashrc|\.bash_profile|\.bash_logout|\.DS_Store|\.gitignore|\.gitattributes|LICENSE|README\.md|CLAUDE\.md|CHANGELOG\.md|CHANGELOG|CONTRIBUTING\.md|TODO\.md|FAQ\.md|composer\.json|composer\.lock|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|\.\w+~|\.swp|\.swo|\.bak(up)?|\.old|\.tmp|\.temp|\.log|\.sql(\.gz)?|docker-compose\.yml|docker\.env|Dockerfile|\.csproj|\.sln|Cargo\.toml|Cargo\.lock|go\.mod|go\.sum|phpunit\.xml|phpunit\.xml|pom\.xml|build\.gradl|pyproject\.toml|requirements\.txt|application(-\w+)?\.(ya?ml|properties))$ {
        return 404;
    }

    # 禁止访问的敏感目录
    location ~* /(\.git|\.svn|\.bzr|\.vscode|\.claude|\.idea|\.ssh|\.github|\.npm|\.yarn|\.pnpm|\.cache|\.husky|\.turbo|\.next|\.nuxt|node_modules|runtime)/ {
        return 404;
    }

    #一键申请SSL证书验证目录相关设置
    location /.well-known {
        root /www/openmusic;
        allow all;
    }

    #禁止在证书验证目录放入敏感文件
    if ( $uri ~ "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|bak)$" ) {
        return 403;
    }

    #LOG START
    access_log /www/wwwlogs/music.example.com.log;
    error_log /www/wwwlogs/music.example.com.error.log;
    #LOG END
}
