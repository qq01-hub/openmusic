# 复制为 .env 后填写所有空值；留空时 Compose 会拒绝启动，请勿提交实际凭据
OPENMUSIC_PORT=4000
OPENMUSIC_BIND_ADDRESS=127.0.0.1
METING_PORT=3000
OPENMUSIC_NETWORK_SUBNET=172.30.80.0/24

# 默认 0（强制 Secure Cookie）；仅纯 HTTP 首次体验时临时设 1，HTTPS 上线后改回 0 并重建 OpenMusic 容器
ALLOW_INSECURE_COOKIES=0

# Meting 管理入口和首次初始化凭据（仅监听宿主机 127.0.0.1，请勿直接暴露公网）
METING_ADMIN_PATH=
METING_ADMIN_USERNAME=
METING_ADMIN_PASSWORD=

# 至少 32 字节随机值，例如：openssl rand -hex 32
ROOM_CREDENTIAL_ENCRYPTION_KEY=

# Redis 密码，例如：openssl rand -hex 32。非空时 Redis 启用 requirepass，主站自动带密码连接；
# 留空则 Redis 无密码（兼容旧部署，不推荐）。从无到有修改后需同时重启 redis 与 openmusic
REDIS_PASSWORD=
# 响度服务专用：与 REDIS_PASSWORD 配套，格式 redis://:<上面的密码>@redis:6379；未设密码时不要填
LOUDNESS_REDIS_URL=

# 首次安装向导的一次性令牌，例如：openssl rand -hex 32（install.sh 自动生成，一般无需手填）
SETUP_TOKEN=

# 应用镜像（可选）：fork 自部署请换成自己的仓库地址；留空使用上游官方镜像
# OPENMUSIC_IMAGE=your-registry/openmusic:latest
# OPENMUSIC_IMAGE_REPOSITORY=your-registry/openmusic
# METING_IMAGE=your-registry/meting-api:latest
# LOUDNESS_IMAGE=your-registry/openmusic-meting-api-audio-loudness:latest
