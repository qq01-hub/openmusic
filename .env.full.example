# 复制为 .env 后填写所有空值；留空时 Compose 会拒绝启动。不要提交实际凭据。
OPENMUSIC_PORT=4000
METING_PORT=3000
OPENMUSIC_NETWORK_SUBNET=172.30.80.0/24

# 首次 IP/HTTP 部署使用 1，HTTPS 上线后改为 0 并重建 OpenMusic 容器
ALLOW_INSECURE_COOKIES=1

# Meting 管理入口和首次初始化凭据。
METING_ADMIN_PATH=
METING_ADMIN_USERNAME=
METING_ADMIN_PASSWORD=

# 至少 32 字节随机值，例如：openssl rand -hex 32
ROOM_CREDENTIAL_ENCRYPTION_KEY=
