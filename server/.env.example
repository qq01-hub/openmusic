# OpenMusic 环境变量示例
#
# 绝大多数业务配置请在管理后台「运行时配置」修改（保存即时生效，无需改本文件、无需重启），包括：
# Meting / 自定义音源、SVIP 与共享会员、OAuth、七牛、接口盒子、
# 空房销毁、房间凭证加密、SEO 等。
#
# 本文件只放「进程级 / 启动必需」项。部署向导会自动写入 Redis、CLIENT_URL、密钥等。
# 下列被注释的项若仍出现在 .env 中，仅作为尚未保存过后台配置时的种子默认值。

# ---------- 服务 ----------
PORT=4000
# NODE_ENV=production

# 生产必填：允许访问的前端 Origin（必须 https），多个用英文逗号分隔；规范主站写在最前
CLIENT_URL=https://your-domain.com

# 生产必填：设备身份与配置加密引导密钥（向导自动生成，须稳定保存）
CLIENT_ID_SECRET=replace_with_a_long_random_secret

# 反代后务必开启；只有来自下列 TCP 代理地址的转发头才会被采信。
TRUST_PROXY=1
# 本机 Nginx 默认值；Docker/独立代理请改成实际网关或代理 IP，多个用英文逗号分隔。
TRUSTED_PROXY_IPS=127.0.0.1,::1

# 有 CDN 时填写回源真实 IP 头（优先于 X-Real-IP / X-Forwarded-For）
# Cloudflare: CF-Connecting-IP
# EdgeOne: iqp
# CLIENT_IP_HEADER=CF-Connecting-IP

# ---------- Redis（必需）----------
# 向导可填；未配置时服务仅允许进入 /setup。房间 / 收藏 / 管理凭据等只存 Redis。

# 方式一：连接串
# REDIS_URL=redis://127.0.0.1:6379/0

# 方式二：分项（账号密码没有就不填）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0

# ---------- 安全（一般不用改）----------
# 账户业务固定使用服务端 Ed25519 签名与 Redis 会话族，不支持关闭鉴权或匿名降级
# 访问令牌固定 3 天，refresh 首次登录起 30 天绝对有效，不通过环境变量延长
# 下列 SESSION_TTL_SEC 仅控制设备 / 房间身份，不授予账户访问权限
# SESSION_TTL_SEC=7776000
# 邮箱验证码
# EMAIL_CODE_TTL_SEC=600
# EMAIL_CODE_RESEND_INTERVAL_SEC=60
# 注册验证码 SMTP 请在管理后台「身份登录 → 注册邮箱（SMTP）」配置。
# 密码会随 runtimeConfig 加密保存，勿写入本文件。

# 生产必须使用 HTTPS，只有明确的受控测试环境才调整 Cookie 安全属性
# ALLOW_INSECURE_COOKIES=0

# ---------- 种子默认值（可选，优先改管理后台）----------
# 以下变量在从未保存过 runtimeConfig 时作为初始值；一旦后台保存过，请只在后台改。
# METING_API_URL=https://meting.example.com
# METING_API_AUTH=
# METING_HEALTH_PROBE_INTERVAL_MS=60000
# ROOM_EMPTY_TTL_MS=600000
# ROOM_RESTART_GRACE_MS=0
# ROOM_CREDENTIAL_ENCRYPTION_KEY=
# ROOM_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# ROOM_CREDENTIAL_MAX_AGE_MS=7776000000
# SVIP_QUALITY_ENABLED=0
# SITE_CANONICAL_URL=https://your-domain.com
#
# Linux.do / GitHub OAuth、七牛、接口盒子、AI 模型服务：请到管理后台填写，不要依赖本文件长期维护。
# AI_API_KEY=
# AI_API_URL=https://api.siliconflow.cn/v1/chat/completions
# AI_TEXT_MODEL=Qwen/Qwen3-8B
# AI_VISION_MODEL=Qwen/Qwen3.5-4B
# AI_MAX_RPM=1000
# AI_MAX_TPM=50000
#
# 管理账号：由部署向导创建，哈希只存 Redis，不写此文件。
# 忘记密码：redis-cli DEL openmusic:admin:credentials → 重启 → 默认 admin / 123456
